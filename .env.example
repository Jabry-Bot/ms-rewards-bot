# Copia este archivo como .env (en la raíz del repo) para configurar SOLO esta
# máquina. El .env no se sube a git. Las variables del entorno de Windows
# tienen prioridad sobre las de aquí.

# --- Modo maintainer: auto-reparación de selectores con IA local (Ollama) ---
# Si un selector del dashboard se rompe, pide a Ollama uno nuevo, lo valida,
# y hace git commit + push para que el resto de bots lo reciban.
MSR_MAINTAINER=0
MSR_OLLAMA_URL=http://localhost:11434
MSR_OLLAMA_MODEL=qwen2.5-coder:7b
